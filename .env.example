# Frontend: copy relevant values to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend: copy relevant values to backend/.env
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./runtime/saucy.db
UPLOAD_DIR=./runtime/uploads
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Saucy Hospitality
DEMO_RESET_TOKEN=change-this-before-deploying
